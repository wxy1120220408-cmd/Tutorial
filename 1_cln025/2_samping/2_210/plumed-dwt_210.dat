UNITS LENGTH=A

MOLINFO MOLTYPE=protein STRUCTURE=cln025-ref.pdb
WHOLEMOLECULES ENTITY0=1-166

# Define CVs

# Select Calpha
PROTEIN: GROUP ATOMS=1-166
CA: GROUP ATOMS=5,26,47,61,73,88,102,109,123,147
# RMSD
rmsd_ca: RMSD REFERENCE=cln025-ca.pdb TYPE=OPTIMAL

# Define descriptors
INCLUDE FILE=./plumed-seldist.dat

ene: ENERGY

